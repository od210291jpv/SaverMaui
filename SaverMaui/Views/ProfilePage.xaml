<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaverMaui.ViewModels"
             x:Class="SaverMaui.Views.ProfilePage"
             Title="Profile"
             BackgroundColor="{StaticResource SurfaceBg}">

    <ContentPage.BindingContext>
        <vm:ProfileViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Content>
        <RefreshView IsRefreshing="{Binding IsRefreshing}"
                     BackgroundColor="{StaticResource SurfaceBg}">
            <ScrollView Orientation="Vertical"
                        HorizontalOptions="Center"
                        VerticalOptions="FillAndExpand"
                        Padding="20"
                        BackgroundColor="{StaticResource SurfaceBg}">

                <VerticalStackLayout Spacing="20" VerticalOptions="Start">

                    <!-- Card 1 — Online Status Card -->
                    <Border Style="{StaticResource CardBorder}"
                            HorizontalOptions="FillAndExpand">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">

                            <!-- Online indicator dot + status text -->
                            <HorizontalStackLayout Grid.Column="0"
                                                   Spacing="8"
                                                   VerticalOptions="Center">
                                <BoxView WidthRequest="12"
                                         HeightRequest="12"
                                         CornerRadius="6"
                                         Color="{Binding OnlineButtonBackgroundColor}"
                                         VerticalOptions="Center" />
                                <Label Text="{Binding OnlineStatusText, FallbackValue=Offline}"
                                       TextColor="{StaticResource TextSecondary}"
                                       FontSize="14"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Tappable hit-area to keep OnOnlineButtonClicked wired up -->
                            <Button Grid.Column="0"
                                    x:Name="OnlineButton"
                                    Text=""
                                    BackgroundColor="Transparent"
                                    BorderColor="Transparent"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    Opacity="0"
                                    VerticalOptions="Center"
                                    Clicked="OnOnlineButtonClicked" />

                            <!-- Status / registration message -->
                            <Label Grid.Column="1"
                                   Text="{Binding StatusMessage, FallbackValue='Create a profile to unlock all features'}"
                                   TextColor="{StaticResource TextSecondary}"
                                   FontSize="13"
                                   VerticalOptions="Center"
                                   HorizontalOptions="FillAndExpand"
                                   HorizontalTextAlignment="Start" />
                        </Grid>
                    </Border>

                    <!-- Card 2 — User Info Card -->
                    <Border Style="{StaticResource CardBorder}"
                            HorizontalOptions="FillAndExpand">
                        <VerticalStackLayout Spacing="10">

                            <!-- Avatar circle -->
                            <Border WidthRequest="72"
                                    HeightRequest="72"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource AccentPrimary}"
                                    StrokeShape="RoundRectangle 36"
                                    HorizontalOptions="Center">
                                <Label Text="👤"
                                       FontSize="32"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <!-- Section header -->
                            <Label Text="User Profile"
                                   Style="{StaticResource SectionLabel}"
                                   HorizontalTextAlignment="Center"
                                   HorizontalOptions="Center" />

                            <!-- Username -->
                            <Label Text="{Binding UserName, Mode=TwoWay}"
                                   TextColor="{StaticResource AccentPrimary}"
                                   FontAttributes="Bold"
                                   FontSize="26"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Card 3 — Search Progress Card -->
                    <Border Style="{StaticResource CardBorder}"
                            HorizontalOptions="FillAndExpand">
                        <VerticalStackLayout Spacing="12">

                            <!-- Header -->
                            <Label Text="Search Progress"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0,0,0,10" />

                            <!-- Progress bar -->
                            <ProgressBar x:Name="SearchProgress"
                                         ProgressColor="{StaticResource AccentPrimary}"
                                         HeightRequest="6" />

                            <!-- Stat row: Total Content -->
                            <Grid ColumnDefinitions="Auto,*" Margin="0,4">
                                <Label Grid.Column="0"
                                       Text="Total Content: "
                                       Style="{StaticResource SubLabel}" />
                                <Label Grid.Column="1"
                                       x:Name="TotalContentAmount"
                                       Text="{Binding TotalContentAmount}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontSize="15"
                                       VerticalOptions="Center" />
                            </Grid>

                            <!-- Stat row: Funds -->
                            <Grid ColumnDefinitions="Auto,*" Margin="0,4">
                                <Label Grid.Column="0"
                                       Text="Funds: "
                                       Style="{StaticResource SubLabel}" />
                                <Label Grid.Column="1"
                                       x:Name="Funds"
                                       Text="{Binding Funds}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontSize="15"
                                       VerticalOptions="Center" />
                            </Grid>

                            <!-- Stat row: Results Found -->
                            <Grid ColumnDefinitions="Auto,*" Margin="0,4">
                                <Label Grid.Column="0"
                                       Text="Results found: "
                                       Style="{StaticResource SubLabel}" />
                                <Label Grid.Column="1"
                                       x:Name="ResultsAmt"
                                       Text="{Binding ResultsAmnt}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontSize="15"
                                       VerticalOptions="Center" />
                            </Grid>

                            <!-- Stat row: Search Status -->
                            <Grid ColumnDefinitions="Auto,*" Margin="0,4">
                                <Label Grid.Column="0"
                                       Text="Search status: "
                                       Style="{StaticResource SubLabel}" />
                                <Label Grid.Column="1"
                                       x:Name="SearchStatuslabel"
                                       Text="{Binding SearchStatus}"
                                       TextColor="{StaticResource AccentPrimary}"
                                       FontSize="15"
                                       VerticalOptions="Center" />
                            </Grid>

                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </ContentPage.Content>

</ContentPage>