<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SaverMaui.Views.NotificationCenterPage"
             xmlns:vm="clr-namespace:SaverMaui.ViewModels"
             Title="Notifications"
             BackgroundColor="{StaticResource SurfaceBg}">

    <ContentPage.BindingContext>
        <vm:NotificationCenterViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Content>
        <Grid RowDefinitions="*,Auto">

            <!-- Row 0: Messages area -->
            <ScrollView Grid.Row="0"
                        BackgroundColor="{StaticResource SurfaceBg}">
                <VerticalStackLayout Spacing="12"
                                     Padding="16,16,16,80">

                    <!-- Header -->
                    <HorizontalStackLayout Spacing="12"
                                           Margin="0,0,0,8">
                        <Label Text="🔔 Notifications"
                               Style="{StaticResource SectionLabel}" />
                    </HorizontalStackLayout>

                    <!-- Messages list -->
                    <CollectionView x:Name="MessagesList"
                                    ItemsSource="{Binding Messages}"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Border Style="{StaticResource CardBorder}">
                                <VerticalStackLayout Spacing="12"
                                                     HorizontalOptions="Center"
                                                     Padding="0,24">
                                    <Label Text="&#x1F514;"
                                           FontSize="48"
                                           HorizontalOptions="Center" />
                                    <Label Text="No notifications yet"
                                           Style="{StaticResource SectionLabel}"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="Connect to start receiving updates"
                                           Style="{StaticResource SubLabel}"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}"
                                        Margin="0,0,0,2"
                                        Padding="16">
                                    <VerticalStackLayout Spacing="8">

                                        <!-- Sender + timestamp row -->
                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="&#x1F4EC;"
                                                   FontSize="16"
                                                   VerticalOptions="Center" />
                                            <Label Text="{Binding SenderName, FallbackValue=System}"
                                                   TextColor="{StaticResource AccentSecondary}"
                                                   FontAttributes="Bold"
                                                   FontSize="15"
                                                   VerticalOptions="Center" />
                                            <BoxView HorizontalOptions="FillAndExpand"
                                                     Color="Transparent" />
                                            <Label Text="{Binding Timestamp, FallbackValue='Just now'}"
                                                   Style="{StaticResource SubLabel}"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>

                                        <!-- Message body -->
                                        <Label Text="{Binding Message}"
                                               TextColor="{StaticResource TextPrimary}"
                                               FontSize="14"
                                               LineBreakMode="WordWrap" />

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>

            <!-- Row 1: Sticky bottom bar -->
            <Border Grid.Row="1"
                    BackgroundColor="{StaticResource SurfaceCard}"
                    StrokeThickness="0"
                    Padding="16,12">
                <Button Text="🔗  Connect"
                        Style="{StaticResource PrimaryButton}"
                        BackgroundColor="{StaticResource AccentSecondary}"
                        Command="{Binding NotifyClientsCommand}" />
            </Border>

        </Grid>
    </ContentPage.Content>
</ContentPage>