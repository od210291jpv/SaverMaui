<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaverMaui.ViewModels"
             x:Class="SaverMaui.Views.FavoritesPage"
             Title="Favorites"
             BackgroundColor="{StaticResource SurfaceBg}">
    <ContentPage.BindingContext>
        <vm:FavoritesViewModel/>
    </ContentPage.BindingContext>

    <ContentPage.Content>
        <VerticalStackLayout Spacing="0" Padding="16">

            <!-- Header -->
            <Label Text="❤️ Favorites"
                   Style="{StaticResource SectionLabel}"
                   Margin="0,0,0,8"/>
            <Label Text="Your saved content"
                   Style="{StaticResource SubLabel}"
                   Margin="0,0,0,24"/>

            <!-- Card A: Categories (disabled / coming soon) -->
            <Border Style="{StaticResource CardBorder}"
                    BackgroundColor="{StaticResource SurfaceCard}"
                    Opacity="0.5"
                    Margin="0,0,0,12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateToFavoriteCategoriesCommand}"/>
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" HeightRequest="56">
                    <Label Grid.Column="0"
                           Text="📁"
                           FontSize="28"
                           VerticalOptions="Center"
                           Margin="0,0,12,0"/>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Categories"
                               TextColor="{StaticResource TextPrimary}"
                               FontAttributes="Bold"
                               FontSize="16"/>
                        <Label Text="Coming soon"
                               Style="{StaticResource SubLabel}"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="2"
                           Text="›"
                           TextColor="{StaticResource TextSecondary}"
                           FontSize="22"
                           VerticalOptions="Center"/>
                </Grid>
            </Border>

            <!-- Card B: Content -->
            <Border Style="{StaticResource CardBorder}"
                    BackgroundColor="{StaticResource SurfaceCard}"
                    Margin="0,0,0,12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateToFavoriteContentCommand}"/>
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" HeightRequest="56">
                    <Label Grid.Column="0"
                           Text="🖼️"
                           FontSize="28"
                           VerticalOptions="Center"
                           Margin="0,0,12,0"/>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Content"
                               TextColor="{StaticResource TextPrimary}"
                               FontAttributes="Bold"
                               FontSize="16"/>
                        <Label Text="Your liked images"
                               Style="{StaticResource SubLabel}"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="2"
                           Text="›"
                           TextColor="{StaticResource TextSecondary}"
                           FontSize="22"
                           VerticalOptions="Center"/>
                </Grid>
            </Border>

            <!-- Card C: My Content (no command yet) -->
            <Border Style="{StaticResource CardBorder}"
                    BackgroundColor="{StaticResource SurfaceCard}"
                    Margin="0,0,0,12">
                <Grid ColumnDefinitions="Auto,*,Auto" HeightRequest="56">
                    <Label Grid.Column="0"
                           Text="⭐"
                           FontSize="28"
                           VerticalOptions="Center"
                           Margin="0,0,12,0"/>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="My Content"
                               TextColor="{StaticResource TextPrimary}"
                               FontAttributes="Bold"
                               FontSize="16"/>
                        <Label Text="Content you created"
                               Style="{StaticResource SubLabel}"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="2"
                           Text="›"
                           TextColor="{StaticResource TextSecondary}"
                           FontSize="22"
                           VerticalOptions="Center"/>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ContentPage.Content>
</ContentPage>