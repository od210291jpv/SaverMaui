<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaverMaui.ViewModels"
             xmlns:vd="clr-namespace:SaverMaui.Custom_Elements"
             x:Class="SaverMaui.Views.FavoriteContentPage"
             xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             Title="Favorites"
             BackgroundColor="Black">

    <ContentPage.BindingContext>
        <vm:FavoriteContentViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Content>
        <Grid>
            <!-- Full-screen CarouselView -->
            <CarouselView Grid.Row="0"
                          ItemsSource="{Binding ContentCollection}"
                          CurrentItem="{Binding CurrentContent}"
                          CurrentItemChangedCommand="{Binding ItemChangedCommand}"
                          IndicatorView="indicatorView">
                <CarouselView.ItemTemplate>
                    <DataTemplate>
                        <vd:ZoomableImage
                            ImageSource="{Binding Path=Source}"
                            LoadingPlaceholder="https://png.pngtree.com/png-vector/20190817/ourmid/pngtree-image-icon---vector-loading-download-and-upload-png-image_1694005.jpg"
                            ErrorPlaceholder="https://png.pngtree.com/png-vector/20190817/ourmid/pngtree-image-icon---vector-loading-download-and-upload-png-image_1694005.jpg"
                            FadeAnimationEnabled="True"
                            ImageAspect="AspectFit"
                            DoubleTapped="OnTapGestureRecognizerTapped" />
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>

            <!-- Dot indicator -->
            <IndicatorView x:Name="indicatorView"
                           Grid.Row="0"
                           IndicatorColor="{StaticResource SurfaceCardHigh}"
                           SelectedIndicatorColor="{StaticResource AccentPrimary}"
                           HorizontalOptions="Center"
                           VerticalOptions="End"
                           Margin="0,0,0,80" />

            <!-- Bottom overlay bar -->
            <Border Grid.Row="0"
                    BackgroundColor="#CC000000"
                    StrokeThickness="0"
                    VerticalOptions="End"
                    Padding="20,12">
                <HorizontalStackLayout Spacing="16" HorizontalOptions="Center">
                    <Label Text="♥ Saved"
                           TextColor="{StaticResource AccentPrimary}"
                           FontSize="16"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </ContentPage.Content>
</ContentPage>