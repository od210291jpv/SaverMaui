<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaverMaui.ViewModels"
             x:Class="SaverMaui.Views.CategoriesPageV2"
             Title="Categories"
             BackgroundColor="{StaticResource SurfaceBg}">

    <ContentPage.BindingContext>
        <vm:CategoriesViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Content>
        <Grid RowDefinitions="Auto,Auto,*" Padding="16">

            <!-- Row 0: Title row -->
            <HorizontalStackLayout Grid.Row="0" Spacing="0">
                <Label Text="🗂️ Categories"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"
                       VerticalOptions="Center" />
                <BoxView HorizontalOptions="FillAndExpand"
                         Color="Transparent" />
            </HorizontalStackLayout>

            <!-- Row 1: Search bar wrapped in Border for styled background -->
            <Border Grid.Row="1"
                    BackgroundColor="{StaticResource SurfaceCardHigh}"
                    StrokeThickness="0"
                    Margin="0,12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <SearchBar Placeholder="Filter categories..."
                           TextColor="{StaticResource TextPrimary}"
                           PlaceholderColor="{StaticResource TextSecondary}"
                           CancelButtonColor="{StaticResource AccentPrimary}"
                           BackgroundColor="Transparent" />
            </Border>

            <!-- Row 2: Category grid -->
            <CollectionView Grid.Row="2"
                            ItemsSource="{Binding Categories}"
                            SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                            SelectionMode="Single">

                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="2"
                                     VerticalItemSpacing="12"
                                     HorizontalItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Padding="0">

                            <SwipeView>
                                <SwipeView.LeftItems>
                                    <SwipeItems>
                                        <SwipeItem Text="Open"
                                                   BackgroundColor="{StaticResource AccentPrimary}"
                                                   Clicked="OnCategoryOpen" />
                                    </SwipeItems>
                                </SwipeView.LeftItems>

                                <!-- Card content: accent bar + name + chevron -->
                                <Grid HeightRequest="90"
                                      Padding="16,0"
                                      ColumnDefinitions="Auto,*,Auto">

                                    <!-- Accent left bar -->
                                    <BoxView Grid.Column="0"
                                             WidthRequest="4"
                                             BackgroundColor="{StaticResource AccentPrimary}"
                                             VerticalOptions="FillAndExpand"
                                             CornerRadius="2" />

                                    <!-- Category name -->
                                    <Label Grid.Column="1"
                                           Text="{Binding Name}"
                                           TextColor="{StaticResource TextPrimary}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           Margin="12,0,0,0" />

                                    <!-- Chevron -->
                                    <Label Grid.Column="2"
                                           Text="›"
                                           TextColor="{StaticResource TextSecondary}"
                                           FontSize="18"
                                           VerticalOptions="Center" />

                                </Grid>
                            </SwipeView>

                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>
    </ContentPage.Content>

</ContentPage>