<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SaverMaui.ViewModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="SaverMaui.Views.VideoManagementPage"
    Title="Video Management"
    BackgroundColor="{StaticResource SurfaceBg}">

    <ContentPage.BindingContext>
        <vm:VideoManagementViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Content>
        <ScrollView BackgroundColor="{StaticResource SurfaceBg}" Padding="16">
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="16">

                    <!-- Header -->
                    <Label Text="🎥 Video Management"
                           Style="{StaticResource SectionLabel}"
                           Margin="0,0,0,8" />

                    <Label Text="Add and sync video content"
                           Style="{StaticResource SubLabel}"
                           Margin="0,0,0,16" />

                    <!-- Video URL Entry -->
                    <Border BackgroundColor="{StaticResource SurfaceCardHigh}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,0">
                        <Entry x:Name="VideoUrlEntry"
                               Style="{StaticResource StyledEntry}"
                               Placeholder="Video URL"
                               Text="{Binding AddVideoUrl}" />
                    </Border>

                    <!-- Video Name Entry -->
                    <Border BackgroundColor="{StaticResource SurfaceCardHigh}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,0">
                        <Entry x:Name="VideoName"
                               Style="{StaticResource StyledEntry}"
                               Placeholder="Video name"
                               Text="{Binding AddVideoName}" />
                    </Border>

                    <!-- Add Video Button -->
                    <Button x:Name="SubmitVideo"
                            Text="➕  Add Video"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding AddVideoCommand}" />

                    <!-- Separator -->
                    <BoxView HeightRequest="1"
                             BackgroundColor="{StaticResource SurfaceCardHigh}"
                             Margin="0,8" />

                    <!-- Picker Label -->
                    <Label Text="Select Video"
                           Style="{StaticResource SubLabel}"
                           Margin="0,0,0,4" />

                    <!-- Video Picker -->
                    <Border BackgroundColor="{StaticResource SurfaceCardHigh}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,4">
                        <Picker Title="Choose a video..."
                                ItemsSource="{Binding Videos}"
                                ItemDisplayBinding="{Binding Title}"
                                SelectedItem="{Binding SelectedVideo}"
                                TextColor="{StaticResource TextPrimary}" />
                    </Border>

                    <!-- Sync Button -->
                    <Button Text="🔄  Sync Video with Backend"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding SyncVideoCommand}" />

                </VerticalStackLayout>
            </Border>
        </ScrollView>
    </ContentPage.Content>

</ContentPage>