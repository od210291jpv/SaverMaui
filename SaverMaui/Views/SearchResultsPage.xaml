<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaverMaui.ViewModels"
             x:Class="SaverMaui.Views.SearchResultsPage"
             xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             Title="Search Results"
             BackgroundColor="Black">
    <ContentPage.BindingContext>
        <vm:SearchResultsViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Content>
        <Grid>
            <CarouselView Loop="False"
                          ItemsSource="{Binding ContentCollection}"
                          Position="{Binding CurrentKeyword}"
                          VerticalScrollBarVisibility="Always">
                <CarouselView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                </CarouselView.ItemsLayout>
                <CarouselView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <!-- Full-screen image -->
                            <ffimageloading:CachedImage
                                Source="{Binding Path=Value[0].Url.Value}"
                                Aspect="AspectFill"
                                FadeAnimationEnabled="True"
                                LoadingPlaceholder="https://png.pngtree.com/png-vector/20190817/ourmid/pngtree-image-icon---vector-loading-download-and-upload-png-image_1694005.jpg"
                                ErrorPlaceholder="https://png.pngtree.com/png-vector/20190817/ourmid/pngtree-image-icon---vector-loading-download-and-upload-png-image_1694005.jpg">
                                <ffimageloading:CachedImage.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCategoryOpen" NumberOfTapsRequired="2" />
                                </ffimageloading:CachedImage.GestureRecognizers>
                            </ffimageloading:CachedImage>

                            <!-- Top overlay bar -->
                            <Border BackgroundColor="#CC000000"
                                    VerticalOptions="Start"
                                    Padding="16,12"
                                    StrokeThickness="0">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Path=Key}"
                                           TextColor="White"
                                           FontAttributes="Bold"
                                           FontSize="22" />
                                    <Label Text="Swipe to browse"
                                           TextColor="{StaticResource TextSecondary}"
                                           FontSize="12"
                                           Margin="0,4,0,0" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>
        </Grid>
    </ContentPage.Content>
</ContentPage>