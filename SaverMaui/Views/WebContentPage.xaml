<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaverMaui.ViewModels"
             x:Class="SaverMaui.Views.WebContentPage"
             Title="Web Content"
             BackgroundColor="{StaticResource SurfaceBg}">

    <ContentPage.BindingContext>
        <vm:WebContentViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*" Padding="16">

        <!-- Row 0: Input card -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorder}"
                Margin="0,0,0,16">
            <VerticalStackLayout Spacing="12">

                <Label Text="🌐 Add Web Content"
                       Style="{StaticResource SectionLabel}"
                       Margin="0,0,0,8" />

                <!-- URL Entry -->
                <Border BackgroundColor="{StaticResource SurfaceCardHigh}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="12,0">
                    <Entry Style="{StaticResource StyledEntry}"
                           Placeholder="URL (https://...)"
                           Text="{Binding ContentUrl, Mode=TwoWay}" />
                </Border>

                <!-- Title Entry -->
                <Border BackgroundColor="{StaticResource SurfaceCardHigh}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="12,0">
                    <Entry Style="{StaticResource StyledEntry}"
                           Placeholder="Title"
                           Text="{Binding ContentTitle, Mode=TwoWay}" />
                </Border>

                <Button Text="➕  Add Content"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddWebContentCmd}" />

            </VerticalStackLayout>
        </Border>

        <!-- Row 1: CollectionView -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding AllWebContent}"
                        SelectedItem="{Binding SelectedWebContent}"
                        SelectionMode="Single">

            <CollectionView.Header>
                <Border BackgroundColor="{StaticResource SurfaceCard}"
                        StrokeThickness="0"
                        Padding="0,0,0,16">
                    <Label Text="Saved Web Content"
                           Style="{StaticResource SectionLabel}" />
                </Border>
            </CollectionView.Header>

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="2"
                                 VerticalItemSpacing="10"
                                 HorizontalItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}" Padding="0">
                        <SwipeView>
                            <SwipeView.LeftItems>
                                <SwipeItems>
                                    <SwipeItem Text="Open"
                                               BackgroundColor="{StaticResource AccentSecondary}"
                                               Clicked="OnWebContentOpen" />
                                </SwipeItems>
                            </SwipeView.LeftItems>

                            <Grid HeightRequest="80"
                                  Padding="12,0"
                                  ColumnDefinitions="Auto,*,Auto">

                                <Label Grid.Column="0"
                                       Text="🌐"
                                       FontSize="20"
                                       VerticalOptions="Center" />

                                <Label Grid.Column="1"
                                       Text="{Binding Path=Title}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       VerticalOptions="Center"
                                       Margin="10,0"
                                       LineBreakMode="TailTruncation" />

                                <Label Grid.Column="2"
                                       Text=">"
                                       TextColor="{StaticResource TextSecondary}"
                                       FontSize="16"
                                       VerticalOptions="Center" />

                            </Grid>
                        </SwipeView>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>