<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaverMaui.ViewModels"
             x:Class="SaverMaui.Views.SettingsPage"
             Title="Settings"
             BackgroundColor="{StaticResource SurfaceBg}">

    <ContentPage.BindingContext>
        <vm:SettingsViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Content>
        <ScrollView Orientation="Vertical"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Start"
                    BackgroundColor="{StaticResource SurfaceBg}">

            <VerticalStackLayout Spacing="16" Padding="16">

                <!-- Card 1 — Global Actions -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">

                        <Label Text="⚙️ Global Actions"
                               Style="{StaticResource SectionLabel}"
                               Margin="0,0,0,12" />

                        <!-- Sync / Post Buttons -->
                        <Button Text="🔄  Sync Content with Backend"
                                Command="{Binding SyncContextCommand}"
                                Style="{StaticResource SecondaryButton}" />

                        <Button Text="📤  Post All Data to Backend"
                                Command="{Binding PostNewContentCommand}"
                                Style="{StaticResource PrimaryButton}" />

                        <!-- Data Management Buttons -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0"
                                    Text="🗑️ Erase Empty"
                                    Command="{Binding EraseEmptyCategoriesCommand}"
                                    Style="{StaticResource DangerButton}" />
                            <Button Grid.Column="1"
                                    Text="⚠️ Wipe All Data"
                                    Command="{Binding WipeAllDataCommand}"
                                    Style="{StaticResource DangerButton}" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Card 2 — Search & Preferences -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="12">

                        <Label Text="🔍 Search &amp; Preferences"
                               Style="{StaticResource SectionLabel}"
                               Margin="0,0,0,12" />

                        <!-- Search Entry -->
                        <Border BackgroundColor="{StaticResource SurfaceCardHigh}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="12,0">
                            <Entry Style="{StaticResource StyledEntry}"
                                   Placeholder="Search keyword..."
                                   Text="{Binding SearchRequest, Mode=TwoWay}" />
                        </Border>

                        <!-- Search Button -->
                        <Button Text="Search"
                                Command="{Binding SearchContent}"
                                Style="{StaticResource PrimaryButton}" />

                        <!-- Clean Results Button -->
                        <Button Text="🧹 Clean Results"
                                Command="{Binding CleanSearchResults}"
                                Style="{StaticResource SecondaryButton}" />

                        <!-- Switch Row — Log Feeds Content -->
                        <Border BackgroundColor="{StaticResource SurfaceCardHigh}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                Padding="12,10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="Log Feeds Content"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontSize="15"
                                       VerticalOptions="Center" />
                                <Switch Grid.Column="1"
                                        OnColor="{StaticResource AccentPrimary}"
                                        IsToggled="{Binding LogFeedsEnabled, Mode=TwoWay}" />
                            </Grid>
                        </Border>

                        <!-- Switch Row — Refresh Search Results -->
                        <Border BackgroundColor="{StaticResource SurfaceCardHigh}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                Padding="12,10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="Refresh Search Results"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontSize="15"
                                       VerticalOptions="Center" />
                                <Switch Grid.Column="1"
                                        OnColor="{StaticResource AccentPrimary}"
                                        IsToggled="{Binding RefreshSearchResults, Mode=TwoWay}"
                                        Toggled="Handle_Toggled" />
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>

</ContentPage>