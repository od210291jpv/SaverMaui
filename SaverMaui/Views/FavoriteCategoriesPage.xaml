<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaverMaui.ViewModels"
             x:Class="SaverMaui.Views.FavoriteCategoriesPage"
             Title="Favorite Categories"
             BackgroundColor="{StaticResource SurfaceBg}">
    <ContentPage.BindingContext>
        <vm:FavoritesViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*,Auto" Padding="16">

            <!-- Row 0: Header -->
            <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,0,0,16">
                <Label Text="📁 Favorite Categories"
                       Style="{StaticResource SectionLabel}" />
                <Label Text="Categories you follow"
                       Style="{StaticResource SubLabel}" />
            </VerticalStackLayout>

            <!-- Row 1: Category list -->
            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding FavoriteCategories}"
                            SelectedItem="{Binding SelectedFavoriteCategory}"
                            SelectionMode="Single">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Padding="0">
                            <Grid ColumnDefinitions="Auto,*,Auto" HeightRequest="60">
                                <Label Grid.Column="0"
                                       Text="🗂️"
                                       FontSize="22"
                                       VerticalOptions="Center"
                                       Margin="16,0,0,0" />
                                <Label Grid.Column="1"
                                       Text="{Binding Path=Name}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       VerticalOptions="Center"
                                       Margin="12,0" />
                                <Label Grid.Column="2"
                                       Text=">"
                                       TextColor="{StaticResource TextSecondary}"
                                       FontSize="18"
                                       VerticalOptions="Center"
                                       Margin="0,0,16,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Row 2: Bottom action bar -->
            <Grid Grid.Row="2"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="12"
                  Margin="0,16,0,0">
                <Button Grid.Column="0"
                        Text="Open Feed"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding NavigateToFeedItemCommand}" />
                <Button Grid.Column="1"
                        Text="Personal Feed"
                        Style="{StaticResource OutlineButton}"
                        Command="{Binding NavigateToPersonalFeedCommand}" />
            </Grid>

        </Grid>
    </ContentPage.Content>
</ContentPage>